# Copy to .env.local and fill in. Never commit real values.
# Local Docker PostgreSQL (container family-pg, port 5434) — see README.
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://family_app:change-me@localhost:5434/family
TEST_DATABASE_URL=postgres://family_app:change-me@localhost:5434/family_test
# 32+ random bytes, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=change-me
